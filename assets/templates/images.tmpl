{{template "public/header" .}}
        <section class="hero">
            <div class="wrap">
                <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Telegram 驱动的无服务器存储</p>
                <h1>上传图片到 Telegram</h1>
                <p class="sub">图片直接存入TG频道，返回永久外链。支持拖拽与剪贴板粘贴，不占用服务器磁盘。</p>
            </div>
        </section>
        <section class="work">
            <div class="wrap">
                <div class="composer">
                    <label class="dropzone" id="uploadFileLabel" for="uploadFile" tabindex="0">
                        <span class="dz-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
                                stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                                <circle cx="9" cy="9" r="2" />
                                <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" />
                            </svg>
                        </span>
                        <span class="dz-title" id="uploadFileName">点击选择图片，或拖到这里</span>
                        <span class="dz-hint">支持 JPG · PNG · 单张不超过 20 MB</span>
                    </label>
                    <input type="file" name="image" id="uploadFile" class="visually-hidden" multiple
                        accept=".jpg, .jpeg, .png" />
                    <div class="composer-bar">
                        <span class="composer-meta" id="uploadMeta">尚未选择图片</span>
                        <span class="composer-quota" id="quotaHint" title="每个浏览器每天最多上传 10 个文件/图片，次日自动重置">今日剩余 10 次</span>
                        <button id="uploadButton" class="send-btn" type="button" aria-label="上传图片" title="上传图片">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="m5 12 7-7 7 7" />
                                <path d="M12 19V5" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div id="loading" class="status" hidden>
                    <div class="status-row">
                        <span class="spinner" aria-hidden="true"></span>
                        <span id="loadingText" class="status-file">正在上传…</span>
                        <span id="loadingPercent" class="status-percent">0%</span>
                    </div>
                    <div id="progress" class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                        aria-valuenow="0" aria-label="上传进度">
                        <div id="progressFill" class="progress-fill"></div>
                    </div>
                </div>
                <div id="response" class="response-list" aria-live="polite"></div>
                <details id="history" class="history" hidden>
                    <summary>
                        <span>历史上传记录</span>
                        <span id="history-count" class="count">0</span>
                        <span class="chev" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </span>
                    </summary>
                    <ul id="history-list"></ul>
                </details>
                <details id="redeem" class="redeem">
                    <summary>
                        <span>有兑换码？可增加上传次数</span>
                        <span class="chev" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </span>
                    </summary>
                    <form id="redeemForm" class="redeem-form" novalidate>
                        <input id="redeemInput" class="redeem-input" type="text" name="code" placeholder="输入兑换码"
                            autocomplete="off" spellcheck="false" maxlength="64" />
                        <button id="redeemButton" class="redeem-button" type="submit">兑换</button>
                    </form>
                    <p id="redeemStatus" class="redeem-status" aria-live="polite"></p>
                </details>
            </div>
        </section>
    <script type="application/json" id="tgstate-page-config">{"mode":"image","maxFileSize":20971520,"chunkSize":20971520,"dailyLimit":10}</script>
{{template "public/footer" .}}