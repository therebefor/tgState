{{define "public/footer"}}
    </main>
    <footer class="site-footer">
        <div class="wrap footer-inner">
            <p>tgState · 把文件存进 Telegram</p>
            <p class="footer-links">
                <a href="https://github.com/therebefor/tgState" target="_blank" rel="noopener">GitHub</a>
                <span aria-hidden="true">·</span>
                <a href="https://core.telegram.org/bots/api" target="_blank" rel="noopener">Telegram Bot API</a>
            </p>
            <p class="footer-copy">© Powered by Therebefore &amp; Deepseek</p>
        </div>
    </footer>
    <script>
        (function () {
            'use strict';

            var API_ENDPOINT = '/api';
            var CHUNK_SIZE = 10 * 1024 * 1024;
            var HISTORY_KEY = 'tgstate_history';
            var HISTORY_MAX = 50;
            var DEFAULT_LOADING_TEXT = '正在上传…';

            // 页面级配置：图床模式下限制单张图片大小，且不做分片上传
            var PAGE_CONFIG = { mode: 'file', maxFileSize: 0, chunkSize: CHUNK_SIZE, dailyLimit: 10 };
            (function readPageConfig() {
                var node = document.getElementById('tgstate-page-config');
                if (!node) return;
                var parsed;
                try {
                    parsed = JSON.parse(node.textContent || '{}') || {};
                } catch (error) {
                    return;
                }
                if (parsed.mode === 'image' || parsed.mode === 'file') PAGE_CONFIG.mode = parsed.mode;
                var max = Number(parsed.maxFileSize);
                if (isFinite(max) && max > 0) PAGE_CONFIG.maxFileSize = max;
                var chunk = Number(parsed.chunkSize);
                if (isFinite(chunk) && chunk > 0) PAGE_CONFIG.chunkSize = chunk;
                var dailyLimit = Number(parsed.dailyLimit);
                if (isFinite(dailyLimit) && dailyLimit >= 0) PAGE_CONFIG.dailyLimit = Math.floor(dailyLimit);
            })();

            var CHECK_ICON = '<path d="M20 6 9 17l-5-5"/>';
            var ALERT_ICON = '<path d="M12 9v4"/><path d="M12 17h.01"/>' +
                '<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>';
            var COPY_ICON = '<rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>' +
                '<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>';

            var fileInput = document.getElementById('uploadFile');
            var dropzone = document.getElementById('uploadFileLabel');
            var nameEl = document.getElementById('uploadFileName');
            var metaEl = document.getElementById('uploadMeta');
            var uploadButton = document.getElementById('uploadButton');
            var loadingEl = document.getElementById('loading');
            var loadingTextEl = document.getElementById('loadingText');
            var responseEl = document.getElementById('response');
            var historyEl = document.getElementById('history');
            var historyListEl = document.getElementById('history-list');
            var historyCountEl = document.getElementById('history-count');
            var quotaHintEl = document.getElementById('quotaHint');
            var progressEl = document.getElementById('progress');
            var progressFillEl = document.getElementById('progressFill');
            var loadingPercentEl = document.getElementById('loadingPercent');

            var defaultName = nameEl ? nameEl.textContent : '';
            var defaultMeta = metaEl ? metaEl.textContent : '';
            var selected = [];
            var busy = false;
            var chipTimers = new WeakMap();

            function el(tag, className, text) {
                var node = document.createElement(tag);
                if (className) node.className = className;
                if (text !== undefined && text !== null) node.textContent = text;
                return node;
            }

            function icon(paths, size) {
                var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                svg.setAttribute('viewBox', '0 0 24 24');
                svg.setAttribute('width', String(size));
                svg.setAttribute('height', String(size));
                svg.setAttribute('fill', 'none');
                svg.setAttribute('stroke', 'currentColor');
                svg.setAttribute('stroke-width', '2');
                svg.setAttribute('stroke-linecap', 'round');
                svg.setAttribute('stroke-linejoin', 'round');
                svg.setAttribute('aria-hidden', 'true');
                svg.innerHTML = paths;
                return svg;
            }

            function escapeHtml(value) {
                return String(value === undefined || value === null ? '' : value).replace(/[&<>"']/g, function (ch) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
                });
            }

            function formatSize(bytes) {
                var value = Number(bytes) || 0;
                if (value < 1024) return value + ' B';
                var units = ['KB', 'MB', 'GB', 'TB'];
                var unit = -1;
                do {
                    value /= 1024;
                    unit += 1;
                } while (value >= 1024 && unit < units.length - 1);
                return (value >= 10 || unit === 0 ? Math.round(value) : Math.round(value * 10) / 10) + ' ' + units[unit];
            }

            // ---- 每日上传额度（防滥用）：每个浏览器一个自然日最多 N 个文件/图片 ----
            var QUOTA_KEY = 'tgstate_quota';

            function pad2(number) {
                return (number < 10 ? '0' : '') + number;
            }

            function todayStr() {
                var d = new Date();
                return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
            }

            function loadQuota() {
                var row = { date: todayStr(), used: 0 };
                try {
                    var raw = window.localStorage.getItem(QUOTA_KEY);
                    var saved = raw ? JSON.parse(raw) : null;
                    if (saved && saved.date === row.date) {
                        var used = Number(saved.used);
                        if (isFinite(used) && used >= 0) row.used = Math.min(Math.floor(used), PAGE_CONFIG.dailyLimit);
                    }
                } catch (error) {
                    // localStorage 不可用时视为未使用
                }
                return row;
            }

            function saveQuota(row) {
                try {
                    window.localStorage.setItem(QUOTA_KEY, JSON.stringify(row));
                } catch (error) {
                    // 忽略写入失败
                }
            }

            function quotaLeft() {
                return Math.max(0, PAGE_CONFIG.dailyLimit - loadQuota().used);
            }

            function refreshQuotaHint() {
                if (!quotaHintEl) return;
                var left = quotaLeft();
                quotaHintEl.textContent = left > 0 ? '今日剩余 ' + left + ' 次' : '今日次数已用完';
                quotaHintEl.title = '每个浏览器每天最多上传 ' + PAGE_CONFIG.dailyLimit + ' 个文件/图片，次日自动重置';
                if (left > 0) quotaHintEl.classList.remove('is-empty');
                else quotaHintEl.classList.add('is-empty');
            }

            function consumeQuota() {
                var row = loadQuota();
                row.used += 1;
                saveQuota(row);
                refreshQuotaHint();
            }

            function toFullUrl(path) {
                if (!path) return '';
                if (/^https?:\/\//i.test(path)) return path;
                return window.location.origin + (path.charAt(0) === '/' ? path : '/' + path);
            }

            function setMeta(text) {
                if (metaEl) metaEl.textContent = text;
            }

            function setName(text, title) {
                if (!nameEl) return;
                nameEl.textContent = text;
                nameEl.title = title || '';
            }

            function setLoading(text) {
                if (loadingTextEl) loadingTextEl.textContent = text || DEFAULT_LOADING_TEXT;
            }

            function setProgress(ratio) {
                var value = Math.max(0, Math.min(1, Number(ratio) || 0));
                var percent = Math.round(value * 100);
                if (progressFillEl) progressFillEl.style.width = percent + '%';
                if (progressEl) progressEl.setAttribute('aria-valuenow', String(percent));
                if (loadingPercentEl) loadingPercentEl.textContent = percent + '%';
            }

            function setBusy(state) {
                busy = !!state;
                if (uploadButton) uploadButton.disabled = busy;
                if (loadingEl) loadingEl.hidden = !busy;
                setLoading(DEFAULT_LOADING_TEXT);
                if (busy) setProgress(0);
            }

            function updateSelection() {
                if (!dropzone) return;
                if (!selected.length) {
                    dropzone.classList.remove('has-files');
                    setName(defaultName);
                    setMeta(defaultMeta);
                    return;
                }
                dropzone.classList.add('has-files');
                if (selected.length === 1) {
                    setName(selected[0].name, selected[0].name);
                    setMeta(selected[0].name + ' · ' + formatSize(selected[0].size));
                    return;
                }
                var total = 0;
                for (var i = 0; i < selected.length; i += 1) total += selected[i].size;
                setName('已选择 ' + selected.length + ' 个文件');
                setMeta(selected.length + ' 个文件 · 共 ' + formatSize(total));
            }

            function resetSelection() {
                selected = [];
                if (fileInput) fileInput.value = '';
                setLoading(DEFAULT_LOADING_TEXT);
                updateSelection();
            }

            function takeFiles(fileList) {
                var files = Array.prototype.slice.call(fileList || []);
                if (!files.length) return false;
                selected = files;
                updateSelection();
                return true;
            }

            function uploadRequest(blob, filename, onProgress) {
                return new Promise(function (resolve, reject) {
                    var form = new FormData();
                    if (filename) form.append('image', blob, filename);
                    else form.append('image', blob);
                    var xhr = new XMLHttpRequest();
                    xhr.open('POST', API_ENDPOINT, true);
                    xhr.withCredentials = true;
                    if (xhr.upload && typeof onProgress === 'function') {
                        xhr.upload.onprogress = function (event) {
                            if (event && event.lengthComputable && event.total > 0) {
                                onProgress(Math.min(event.loaded / event.total, 1));
                            }
                        };
                    }
                    xhr.onload = function () {
                        if (xhr.status === 401 || xhr.status === 403) {
                            reject(new Error('没有访问权限，请刷新页面后重新验证'));
                            return;
                        }
                        if (xhr.status < 200 || xhr.status >= 300) {
                            reject(new Error('服务器返回 HTTP ' + xhr.status));
                            return;
                        }
                        var data;
                        try {
                            data = JSON.parse(xhr.responseText || '');
                        } catch (error) {
                            reject(new Error('服务器返回数据无法解析，请稍后重试'));
                            return;
                        }
                        if (!data || data.code !== 1) {
                            var message = data && (data.message || data.msg);
                            reject(new Error(message ? String(message) : '上传失败，请稍后重试'));
                            return;
                        }
                        resolve(data);
                    };
                    xhr.onerror = function () {
                        reject(new Error('网络连接失败，请检查网络后重试'));
                    };
                    xhr.ontimeout = function () {
                        reject(new Error('上传超时，请稍后重试'));
                    };
                    xhr.onabort = function () {
                        reject(new Error('上传已取消'));
                    };
                    xhr.send(form);
                });
            }

            async function uploadFile(file, onProgress) {
                var report = typeof onProgress === 'function' ? onProgress : function () {};
                if (file.size <= PAGE_CONFIG.chunkSize) {
                    var single = await uploadRequest(file, file.name, report);
                    report(1);
                    return { name: file.name, link: single.message };
                }
                var index = 'tgstate-blob\n' + file.name + '\nsize' + file.size;
                var offset = 0;
                while (offset < file.size) {
                    var chunk = file.slice(offset, Math.min(offset + PAGE_CONFIG.chunkSize, file.size));
                    var chunkStart = offset;
                    var chunkData = await uploadRequest(chunk, null, function (ratio) {
                        report((chunkStart + ratio * chunk.size) / file.size);
                    });
                    index += '\n' + String(chunkData.message || '').replace(/^\/d\//, '');
                    offset += chunk.size;
                }
                var indexFile = new File([index], 'fileAll.txt', { type: 'text/plain' });
                var indexData = await uploadRequest(indexFile, 'fileAll.txt');
                report(1);
                return { name: file.name, link: indexData.message };
            }

            async function uploadSelected() {
                if (busy || !selected.length) return;
                var files = selected.slice();
                selected = [];
                setBusy(true);
                try {
                    for (var i = 0; i < files.length; i += 1) {
                        var file = files[i];
                        setMeta('正在上传 ' + (i + 1) + ' / ' + files.length + ' · ' + file.name);
                        setLoading('正在上传 ' + file.name);
                        if (quotaLeft() <= 0) {
                            showError(new Error('今日上传次数已用完，每天最多上传 ' + PAGE_CONFIG.dailyLimit + ' 个'), file.name);
                            break;
                        }
                        if (PAGE_CONFIG.maxFileSize > 0 && file.size > PAGE_CONFIG.maxFileSize) {
                            showError(new Error('图片不能超过 ' + formatSize(PAGE_CONFIG.maxFileSize)), file.name);
                            continue;
                        }
                        try {
                            var result = await uploadFile(file, setProgress);
                            consumeQuota();
                            showSuccess(file, result);
                            addHistory(result.name, result.link);
                        } catch (error) {
                            showError(error, file.name);
                        }
                    }
                } finally {
                    setBusy(false);
                    resetSelection();
                }
            }

            function showSuccess(file, result) {
                if (!responseEl) return;
                var url = toFullUrl(result.link);
                if (!url) return;
                var isImage = (file.type || '').indexOf('image/') === 0;
                var formats = { link: url };
                if (isImage) {
                    var safeUrl = escapeHtml(url);
                    var safeAlt = escapeHtml(file.name);
                    formats.html = '<img src="' + safeUrl + '" alt="' + safeAlt + '">';
                    formats.markdown = '![' + safeAlt + '](' + safeUrl + ')';
                    formats.bbcode = '[img]' + safeUrl + '[/img]';
                }
                var item = el('div', 'response-item response-success');
                var head = el('div', 'resp-head');
                var badge = el('span', 'resp-icon');
                badge.appendChild(icon(CHECK_ICON, 12));
                head.appendChild(badge);
                head.appendChild(el('span', 'resp-title', isImage ? '上传成功 · 图片外链' : '上传成功 · 文件外链'));
                item.appendChild(head);
                var link = el('a', 'resp-link', url);
                link.href = url;
                link.target = '_blank';
                link.rel = 'noopener';
                link.title = url;
                item.appendChild(link);
                var actions = el('div', 'resp-actions');
                var defs = [{ key: 'link', label: '复制链接' }];
                if (isImage) {
                    defs.push({ key: 'html', label: 'HTML' });
                    defs.push({ key: 'markdown', label: 'Markdown' });
                    defs.push({ key: 'bbcode', label: 'BBCode' });
                }
                defs.forEach(function (def) {
                    var chip = el('button', 'chip', def.label);
                    chip.type = 'button';
                    chip.addEventListener('click', function () {
                        copyText(formats[def.key]).then(function () {
                            flashChip(chip, '已复制');
                        }, function () {
                            flashChip(chip, '复制失败');
                        });
                    });
                    actions.appendChild(chip);
                });
                item.appendChild(actions);
                responseEl.insertBefore(item, responseEl.firstChild);
            }

            function showError(error, fileName) {
                if (!responseEl) return;
                var message = messageOf(error);
                var item = el('div', 'response-item response-error');
                var head = el('div', 'resp-head');
                var badge = el('span', 'resp-icon');
                badge.appendChild(icon(ALERT_ICON, 13));
                head.appendChild(badge);
                head.appendChild(el('span', 'resp-title', fileName ? '上传失败 · ' + fileName : '上传失败'));
                item.appendChild(head);
                item.appendChild(el('p', 'resp-desc', message));
                responseEl.insertBefore(item, responseEl.firstChild);
            }

            function messageOf(error) {
                if (error && error.message) return String(error.message);
                return '上传失败，请稍后重试';
            }

            function legacyCopy(text) {
                return new Promise(function (resolve, reject) {
                    var area = document.createElement('textarea');
                    area.value = text;
                    area.setAttribute('readonly', 'readonly');
                    area.style.position = 'fixed';
                    area.style.top = '-1000px';
                    area.style.left = '0';
                    area.style.opacity = '0';
                    document.body.appendChild(area);
                    area.select();
                    area.setSelectionRange(0, text.length);
                    var copied = false;
                    try {
                        copied = document.execCommand('copy');
                    } catch (error) {
                        copied = false;
                    }
                    document.body.removeChild(area);
                    if (copied) resolve();
                    else reject(new Error('复制失败'));
                });
            }

            function copyText(text) {
                if (navigator.clipboard && window.isSecureContext) {
                    return navigator.clipboard.writeText(text).catch(function () {
                        return legacyCopy(text);
                    });
                }
                return legacyCopy(text);
            }

            function flashChip(button, text) {
                if (!button) return;
                if (!button.dataset.label) button.dataset.label = button.textContent;
                button.textContent = text;
                button.classList.add('is-copied');
                clearTimeout(chipTimers.get(button));
                chipTimers.set(button, setTimeout(function () {
                    button.textContent = button.dataset.label;
                    button.classList.remove('is-copied');
                }, 1500));
            }

            function loadHistory() {
                try {
                    var raw = window.localStorage.getItem(HISTORY_KEY);
                    if (!raw) return [];
                    var rows = JSON.parse(raw);
                    if (!Array.isArray(rows)) return [];
                    return rows.filter(function (row) {
                        return row && row.name && row.url;
                    });
                } catch (error) {
                    return [];
                }
            }

            function saveHistory(rows) {
                try {
                    window.localStorage.setItem(HISTORY_KEY, JSON.stringify(rows));
                } catch (error) {
                    /* 忽略隐私模式或配额限制导致的写入失败 */
                }
            }

            function timeLabel(time) {
                var date = new Date(time || Date.now());
                if (isNaN(date.getTime())) return '';
                var now = new Date();
                var month = String(date.getMonth() + 1).padStart(2, '0');
                var day = String(date.getDate()).padStart(2, '0');
                var hours = String(date.getHours()).padStart(2, '0');
                var minutes = String(date.getMinutes()).padStart(2, '0');
                var prefix = date.getFullYear() === now.getFullYear() ? '' : date.getFullYear() + '-';
                return prefix + month + '-' + day + ' ' + hours + ':' + minutes;
            }

            function addHistory(name, url) {
                var fullUrl = toFullUrl(url);
                if (!fullUrl) return;
                var rows = loadHistory().filter(function (row) {
                    return !(row.name === name && row.url === fullUrl);
                });
                rows.unshift({ name: name, url: fullUrl, time: Date.now() });
                if (rows.length > HISTORY_MAX) rows = rows.slice(0, HISTORY_MAX);
                saveHistory(rows);
                renderHistory();
            }

            function renderHistory() {
                if (!historyEl || !historyListEl) return;
                var rows = loadHistory();
                historyListEl.textContent = '';
                if (historyCountEl) historyCountEl.textContent = String(rows.length);
                if (!rows.length) {
                    historyEl.hidden = true;
                    return;
                }
                historyEl.hidden = false;
                rows.forEach(function (row) {
                    var li = el('li');
                    var name = el('span', 'history-name', row.name);
                    name.title = row.name;
                    var url = el('span', 'history-url', row.url.replace(/^https?:\/\/[^/]+/i, ''));
                    url.title = row.url;
                    var time = el('span', 'history-time', timeLabel(row.time));
                    var copy = el('button', 'history-copy');
                    copy.type = 'button';
                    copy.title = '复制链接';
                    copy.setAttribute('aria-label', '复制 ' + row.name + ' 的链接');
                    copy.appendChild(icon(COPY_ICON, 13));
                    copy.addEventListener('click', function () {
                        if (copy.classList.contains('is-copied')) return;
                        copyText(row.url).then(function () {
                            copy.classList.add('is-copied');
                            copy.textContent = '';
                            copy.appendChild(icon(CHECK_ICON, 13));
                            setTimeout(function () {
                                copy.classList.remove('is-copied');
                                copy.textContent = '';
                                copy.appendChild(icon(COPY_ICON, 13));
                            }, 1500);
                        }, function () {
                            copy.title = '复制失败';
                        });
                    });
                    li.appendChild(name);
                    li.appendChild(url);
                    li.appendChild(time);
                    li.appendChild(copy);
                    historyListEl.appendChild(li);
                });
            }

            function initUploader() {
                if (!fileInput || !dropzone || !uploadButton) return;

                fileInput.addEventListener('change', function () {
                    takeFiles(fileInput.files);
                });

                uploadButton.addEventListener('click', function () {
                    if (busy) return;
                    if (!selected.length) {
                        fileInput.click();
                        return;
                    }
                    uploadSelected();
                });

                ['dragenter', 'dragover'].forEach(function (type) {
                    dropzone.addEventListener(type, function (event) {
                        event.preventDefault();
                        if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy';
                        dropzone.classList.add('is-dragover');
                    });
                });

                dropzone.addEventListener('dragleave', function (event) {
                    if (event.relatedTarget && dropzone.contains(event.relatedTarget)) return;
                    dropzone.classList.remove('is-dragover');
                });

                dropzone.addEventListener('drop', function (event) {
                    event.preventDefault();
                    dropzone.classList.remove('is-dragover');
                    if (!event.dataTransfer) return;
                    if (takeFiles(event.dataTransfer.files)) uploadSelected();
                });

                dropzone.addEventListener('keydown', function (event) {
                    if (event.key !== 'Enter' && event.key !== ' ' && event.key !== 'Spacebar') return;
                    event.preventDefault();
                    fileInput.click();
                });

                document.addEventListener('dragover', function (event) {
                    if (!event.dataTransfer || !event.dataTransfer.types) return;
                    if (Array.prototype.indexOf.call(event.dataTransfer.types, 'Files') !== -1) {
                        event.preventDefault();
                    }
                });

                document.addEventListener('drop', function (event) {
                    if (!dropzone.contains(event.target)) event.preventDefault();
                });

                document.addEventListener('paste', function (event) {
                    if (!event.clipboardData) return;
                    var items = event.clipboardData.items || [];
                    var files = [];
                    for (var i = 0; i < items.length; i += 1) {
                        var item = items[i];
                        if (item.kind !== 'file' || !item.type || item.type.indexOf('image/') !== 0) continue;
                        var file = item.getAsFile();
                        if (file) files.push(file);
                    }
                    if (!files.length) return;
                    event.preventDefault();
                    if (takeFiles(files)) uploadSelected();
                });
            }

            initUploader();
            renderHistory();
            refreshQuotaHint();
        })();
    </script>
</body>
</html>
{{end}}